# Copy to server/.env for local development, or set these in the Render dashboard.
PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string (mongodb+srv://user:pass@cluster/dbname)
MONGO_URL=

# Secret used to sign JWTs
JWT_SECRET=

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma separated list of allowed browser origins
CLIENT_URL=https://thepetroshop.com,https://www.thepetroshop.com
